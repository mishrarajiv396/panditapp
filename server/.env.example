# Copy this file to .env and fill in your MySQL password.
PORT=4000
NODE_ENV=development

# --- MySQL ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD
DB_NAME=panditapp

# Comma-separated list of browser origins allowed to call the API.
# Local static server + API itself are included by default.
CORS_ORIGIN=http://127.0.0.1:8123,http://localhost:8123,http://localhost:4000,http://127.0.0.1:4000

# --- Admin / auth --------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Used by `npm run seed` to create the first admin account.
ADMIN_EMAIL=admin@panditapp.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Site Admin
