{
  "name": "panditapp",
  "version": "1.0.0",
  "private": true,
  "description": "Satyanarayan Puja website + Express/MySQL API",
  "scripts": {
    "postinstall": "npm --prefix server install --no-audit --no-fund",
    "start": "node server/scripts/deploy.js",
    "deploy": "node server/scripts/deploy.js",
    "migrate": "node server/scripts/migrate.js",
    "seed": "node server/scripts/seed.js",
    "setup": "npm run migrate && npm run seed",
    "dev": "node --watch server/src/server.js"
  },
  "engines": {
    "node": ">=18"
  }
}
